import pandas as pd
import numpy as np
import math
from pathlib import Path

# === Função para calcular energia (vetorizada) - Segue o Modelo Original ===
def calcular_energia_vetorizado(massa_kg, area_frontal_m2, coef_rolamento, coef_arrasto,
                                 velocidade_kmh, eficiencia, dist_m, inclinacao_percent):
    """
    Calcula a energia consumida em um trecho de forma vetorizada, usando
    a inclinação de cada trecho individual.
    """
    g = 9.81
    rho_ar = 1.2
    v = velocidade_kmh / 3.6
    d = dist_m

    angulo_rad = np.arctan(inclinacao_percent / 100.0)

    F_r = massa_kg * g * coef_rolamento
    F_a = 0.5 * rho_ar * area_frontal_m2 * coef_arrasto * (v ** 2)
    F_g = massa_kg * g * np.sin(angulo_rad)

    F_total = F_r + F_a + F_g
    F_total = np.maximum(0, F_total)

    energia_joules = (F_total * d) / eficiencia
    return energia_joules / 3_600_000.0

# === Parâmetros do ônibus ===
massa_kg = 23375
area_frontal_m2 = 8.48
coef_rolamento = 0.0098
coef_arrasto = 0.79
eficiencia = 0.82

# === Arquivos ===
base_path = Path(r"G:\Meu Drive\SMTR\Consumo_Energetico")
arquivo_trechos = base_path / "dados_trechos1.csv"
arquivo_velocidades = base_path / "velocidades_linhas.csv"

# === Função para limpar picos de elevação ===
def limpar_picos_elevacao(df_group, threshold_m=10):
    """
    Suaviza picos de elevação em uma série, substituindo-os pela média de seus vizinhos.
    Opera em grupos (rotas) para evitar quebrar a sequência.
    """
    elev_prev = df_group['elev_m'].shift(1)
    elev_next = df_group['elev_m'].shift(-1)
    
    elev_vizinhos = (elev_prev + elev_next) / 2
    
    is_pico = abs(df_group['elev_m'] - elev_vizinhos) > threshold_m
    
    df_group['elev_m_limpo'] = np.where(is_pico, elev_vizinhos, df_group['elev_m'])
    
    return df_group

# === Leitura segura dos dados ===
try:
    df = pd.read_csv(arquivo_trechos, sep=';', encoding='utf-8')
    df_vel = pd.read_csv(arquivo_velocidades, sep=';', encoding='utf-8')
    
    df.columns = df.columns.str.strip().str.lower().str.replace('\ufeff', '', regex=False)
    df_vel.columns = df_vel.columns.str.strip().str.lower().str.replace('\ufeff', '', regex=False)

    for c in ['servico', 'direcao', 'shape_dist', 'elev_m', 'shape_pt_s']:
        if c not in df.columns:
            raise ValueError(f"Coluna ausente no arquivo de trechos: {c}")

    for c in ['servico', 'velocidade_kmh']:
        if c not in df_vel.columns:
            raise ValueError(f"Coluna ausente no arquivo de velocidades: {c}")

    df['shape_dist'] = pd.to_numeric(df['shape_dist'], errors='coerce')
    df['elev_m'] = pd.to_numeric(df['elev_m'], errors='coerce')
    df_vel['velocidade_kmh'] = pd.to_numeric(df_vel['velocidade_kmh'], errors='coerce')

except FileNotFoundError as e:
    print(f"Erro: O arquivo não foi encontrado. Verifique o caminho e o nome do arquivo: {e.filename}")
    exit()

# === PRÉ-PROCESSAMENTO: SUAVIZAR PICOS DE ELEVAÇÃO ===
df = df.sort_values(['servico', 'direcao', 'shape_pt_s']).reset_index(drop=True)

df_limpo = df.groupby(['servico', 'direcao']).apply(limpar_picos_elevacao, threshold_m=10)
df_limpo = df_limpo.reset_index(drop=True)

# === CÁLCULO DAS INCLINAÇÕES APÓS A LIMPEZA ===
df_limpo['dist_trecho_m'] = df_limpo.groupby(['servico', 'direcao'])['shape_dist'].diff().fillna(0)
df_limpo['delta_elev_m'] = df_limpo.groupby(['servico', 'direcao'])['elev_m_limpo'].diff().fillna(0)

df_limpo['inclinacao_percent'] = (df_limpo['delta_elev_m'] / df_limpo['dist_trecho_m']) * 100
df_limpo['inclinacao_percent'] = df_limpo['inclinacao_percent'].replace([np.inf, -np.inf], 0).fillna(0)

# === Merge com velocidades ===
df_limpo = df_limpo.merge(df_vel, on='servico', how='left')

# === Calcular energia usando a inclinação limpa de cada trecho ===
df_limpo['energia_kwh'] = calcular_energia_vetorizado(
    massa_kg, area_frontal_m2, coef_rolamento, coef_arrasto,
    df_limpo['velocidade_kmh'], eficiencia,
    df_limpo['dist_trecho_m'], df_limpo['inclinacao_percent']
)

# === RESUMO POR LINHA E DIREÇÃO ===
resumo = df_limpo.groupby(['servico', 'direcao'], as_index=False).agg(
    distancia_total_m=('dist_trecho_m', 'sum'),
    energia_total_kwh=('energia_kwh', 'sum'),
    media_inclinacao_percent=('inclinacao_percent', 'mean')
)
resumo['distancia_total_km'] = resumo['distancia_total_m'] / 1000
resumo['consumo_medio_kwh_km'] = resumo['energia_total_kwh'] / resumo['distancia_total_km']

# === SALVAR ===
df_limpo.to_csv(base_path / "resultado_detalhado_picos_suavizados_por_trecho.csv", sep=';', index=False)
resumo.to_csv(base_path / "resultado_resumo_picos_suavizados_por_trecho.csv", sep=';', index=False)
print("✅ Concluído!")

# === CONSUMO MÉDIO POR LINHA (ambos os sentidos) ===
resumo_linha = resumo.groupby('servico', as_index=False).agg(
    distancia_total_m=('distancia_total_m', 'sum'),
    energia_total_kwh=('energia_total_kwh', 'sum')
)
resumo_linha['distancia_total_km'] = resumo_linha['distancia_total_m'] / 1000
resumo_linha['consumo_medio_kwh_km'] = resumo_linha['energia_total_kwh'] / resumo_linha['distancia_total_km']
resumo_linha.to_csv(
    base_path / "resultado_resumo_por_linha_picos_suavizados_por_trecho.csv",
    sep=';', index=False
)
print("📊 Resumo por linha salvo em 'resultado_resumo_por_linha_picos_suavizados_por_trecho.csv'")
